{
    "version": "0.2.0",
    "configurations": [
    
        {
            "name": "Debug sing-box",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            // 指定 sing-box 的入口 main.go 所在路径（通常在根目录或 cmd/sing-box 目录下）
            "program": "${workspaceFolder}/cmd/sing-box", 
            // 调试时传递的参数，比如指定配置文件
            "args": [
                "run",
                "-c",
                "${workspaceFolder}/config.json"
            ],
            // 如果你的配置文件需要 root 权限才能绑定端口或创建 TUN 网卡，可以开启下面这行（Mac/Linux下会弹窗输入密码）
            // "sudo": true 
        }
    ]
}